// 새 서버 DB. GMM110의 60종(Roster60*) 모델만 정리해서 옮김. 예전 체계(수비대·챗봇·예전 대전) 모델은 없음.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(uuid())
  identity  String   @unique // 시제품: "test:<이름>"만 로그인 가능
  nickname  String?
  isTest    Boolean  @default(true)
  credits   Int      @default(0) // 지원서(모집 재화)
  peanut    Int      @default(0) // 땅콩(환생 두 번째부터 1개, 상점은 8단계)
  revision  Int      @default(0)
  createdAt DateTime @default(now())

  loginCodes LoginCode[]
  units      Owned[]
  items      PlayerItem[]
  party      Party?
  battles    Battle[]
  receipts   Receipt[]
  observed   ObservedDefense[]
  onboarding OnboardingState?
  recruits   RecruitSession[]
  story      StoryAccount?
  adventures Adventure[]
  commander  CommanderAccount?
  commanderLedger CommanderXpLedger[]
  rebirth    RebirthAccount?
  pvpParty   PvpParty?
  pvpQueue   PvpQueue?
  ranked     RankedProfile?
  casual     CasualRating?
}

model LoginCode {
  code      String    @id // 6자리, 한 번만 사용
  playerId  String
  expiresAt DateTime
  usedAt    DateTime?
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// 보유 개체. totalXp는 지금 성장 주기(환생 뒤 0부터)의 누적 경험치.
model Owned {
  id                   String   @id @default(uuid())
  playerId             String
  speciesId            String
  totalXp              BigInt   @default(0)
  reincarnation        Int      @default(0)
  status               String   @default("AVAILABLE") // AVAILABLE | BATTLE | ADVENTURE(모험 중) | PVP_QUEUE(대전 대기) | PVP(대전 중)
  locked               Boolean  @default(false)
  source               String // 획득 경로(같은 경로로 두 번 지급하지 않게)
  skillInheritanceJson String? // 조합으로 물려받은 기술 한 칸
  createdAt            DateTime @default(now())
  player               Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, source])
  @@index([playerId, speciesId])
}

model PlayerItem {
  playerId String
  itemId   String
  count    Int    @default(0)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, itemId])
}

// 기본 편성(1~3마리, ownedId JSON 배열). 전투를 만들 때는 요청에 담긴 편성을 씀.
model Party {
  playerId  String   @id
  ownedIds  String
  updatedAt DateTime @updatedAt
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Battle {
  id         String   @id
  playerId   String
  ownedId    String // 처음 출전한 개체
  revision   Int      @default(0)
  status     String   @default("ACTIVE") // ACTIVE | FINISHED | SETTLED
  seed       String // 서버 비밀 씨앗. 응답에 넣지 않음
  snapshot   String // 만들 때 고정한 정책·조우·경험치 계획·관측 스냅샷
  state      String
  settlement String?
  createdAt  DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
}

// 같은 requestId로 다시 보낸 요청에 처음 결과를 돌려주기 위한 영수증
model Receipt {
  playerId    String
  scope       String
  requestId   String
  fingerprint String
  result      String
  createdAt   DateTime @default(now())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, scope, requestId])
}

// 한 번 맞혀 본 종의 방어 반응(플레이어별)
model ObservedDefense {
  playerId        String
  speciesId       String
  profileKey      String
  element         String
  reaction        String
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @updatedAt
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, speciesId, profileKey, element])
  @@index([playerId, speciesId])
}

// 첫 갈매미 흐름(원본 Roster60State): 시작 → 튜토리얼 전투 승리(정산) → 커먼 선택지급권 → 커먼 7종 중 하나
model OnboardingState {
  playerId       String    @id
  starterId      String    @unique // 시작하며 받은 갈매미맨(u01) 개체
  tutorialProof  String? // 튜토리얼 전투를 이기고 정산한 전투 ID(서버만 기록)
  completedAt    DateTime?
  ticketId       String?   @unique // 커먼 선택지급권
  selectedId     String? // 고른 종
  rewardOwnedId  String?
  catalogVersion String?
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// 모집 후보 한 장(원본 Roster60RecruitSession). status: PENDING | CLAIMED | REJECTED
model RecruitSession {
  id        String   @id @default(uuid())
  playerId  String
  revision  Int      @default(0)
  status    String   @default("PENDING")
  snapshot  String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
}

// 스토리 진행(계정 하나에 하나, 원본 Roster60StoryAccount). state = shared StoryProgress JSON.
// 흑화 재료(어둠의 새우Gang): 잔액·누적. 쓰는 곳(강화)은 원본에서도 아직 없음.
model StoryAccount {
  playerId         String @id
  contentVersion   String
  state            String
  darkGangBalance  Int    @default(0)
  darkGangLifetime Int    @default(0)
  revision         Int    @default(0)
  player           Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// 모험 한 번(원본 Roster60Adventure). status: ACTIVE | RETURNED(정상 귀환) | LOST(전멸, 미정산 보상 잃음)
// state = {party(전투 개체, 남은 체력), members(출발 때 경험치), storyQuestId?, commanderReturnEvidence}
// pendingRewards = 귀환 때 받을 보상(전투마다 쌓임). 화면에서 보상 값을 받지 않음.
model Adventure {
  id             String   @id @default(uuid())
  playerId       String
  revision       Int      @default(0)
  status         String   @default("ACTIVE")
  activeBattleId String?
  catalogVersion String
  state          String
  pendingRewards String
  settlement     String?
  createdAt      DateTime @default(now())
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status])
}

// 방범대장 계정 경험치(원본 CommanderAccount). 개체 경험치와 따로 쌓임. 정책 버전·지문이 바뀌면 POLICY_MISMATCH.
model CommanderAccount {
  playerId          String @id
  totalXp           BigInt @default(0)
  policyVersion     String
  policyFingerprint String
  revision          Int    @default(0)
  player            Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// 방범대장 경험치 장부: 같은 사건은 한 번만(원본 CommanderXpLedger)
model CommanderXpLedger {
  playerId          String
  eventKind         String
  eventId           String
  fingerprint       String
  policyVersion     String
  policyFingerprint String
  outcome           String
  reason            String
  status            String
  requestedXp       Int
  appliedXp         Int
  startingXp        BigInt
  endingXp          BigInt
  result            String
  createdAt         DateTime @default(now())
  player            Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, eventKind, eventId])
}

// 환생 성공 횟수(계정 첫 성공 무료 판정, 원본 Roster60RebirthAccount)
model RebirthAccount {
  playerId  String @id
  successes Int    @default(0)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ── 대전(원본 Roster60PvpParty·Roster60PvpQueue·Roster60PvpMatch, RankedProfile·CasualHumanRating) ──
// 대전 편성(일반·랭크 같이 씀, 1~3마리)
model PvpParty {
  playerId String @id
  ownedIds String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// 대기열 한 줄. 들어올 때 정해 둔 값(점수·등급·환생 이력 묶음·일반전 경험치 계획·방범대장 정책·랭크 자격)을 고정해 둠
model PvpQueue {
  playerId      String   @id
  mode          String // normal | rank
  rating        Int
  tierIndex     Int
  ownedIds      String
  queuedAt      DateTime
  leaseUntil    DateTime // 45초 안에 다시 조회하지 않으면 대기열에서 빠짐
  normalXp      String?
  commander     String?
  rankAdmission String?
  pool          String? // FIRST_LIFE | REBORN
  rebirthCount  Int?
  countSource   String?
  historyStamp  String?
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([mode, queuedAt])
}

// 대전 방. player1Id가 'AI:<방 id>'면 AI 상대. status: ACCEPTING(수락 대기 10초) | ACTIVE | FINISHED | SETTLED
model PvpMatch {
  id         String   @id
  player0Id  String
  player1Id  String
  mode       String
  status     String   @default("ACCEPTING")
  revision   Int      @default(0)
  seed       String
  snapshot   String
  state      String
  presence   String?
  deadline   DateTime
  settlement String?
  createdAt  DateTime @default(now())

  @@index([status, deadline])
  @@index([player0Id])
  @@index([player1Id])
}

model RankedProfile {
  playerId          String @id
  tierIndex         Int     @default(0)
  lp                Int     @default(0)
  promotionActive   Boolean @default(false)
  promotionWins     Int     @default(0)
  promotionLosses   Int     @default(0)
  rankedMmr         Float   @default(1000)
  casualPriorOffset Float   @default(0)
  games             Int     @default(0)
  wins              Int     @default(0)
  losses            Int     @default(0)
  draws             Int     @default(0)
  version           Int     @default(0)
  player            Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model CasualRating {
  playerId String @id
  mmr      Float  @default(1000)
  games    Int    @default(0)
  wins     Int    @default(0)
  losses   Int    @default(0)
  draws    Int    @default(0)
  version  Int    @default(0)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// 서버 공용 값(접속 판정 관측 기록 등)
model KeyValue {
  key   String @id
  value String
}
